      </div>
      <div class="footer-bottom">
        <span class="footer-copy">© {new Date().getFullYear()} Holiveiras Promoção de Vendas Ltda. Todos os direitos reservados.</span>
        <span class="footer-copy">Parceiro Autorizado <strong style="color:#F2B705">EMIVE</strong></span>
      </div>
    </div>
  </footer>
</BaseLayout>
